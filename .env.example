# === Server Config ===
# Local development: 8081
# Production deployment: 8080 (8081 for now)
PORT=8081

# === App Environment ===
# Use "development" locally to disable secure cookies
# Use "production" on deployed server (HTTPS required)
NODE_ENV=development

# === Database Config ===
# Connection Pool (runtime)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?pgbouncer=true

# Direct connection (for Prisma migrate/studio)
DIRECT_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require

# === JWT / Tokens ===
ACCESS_TOKEN_SECRET=<your_access_token_secret>
REFRESH_TOKEN_SECRET=<your_refresh_token_secret>
ACCESS_TOKEN_EXPIRES=1h
REFRESH_TOKEN_EXPIRES=7d

# === Redis ===
# Optional caching or queue system
ENABLE_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:<redis_password>@127.0.0.1:6379

# === Google OAuth2 ===
# Google OAuth credentials for login integration
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>

# Callback endpoint (must match Google Cloud Console)
# - Local: http://localhost:8081/api/v1/auth/google/callback
# - Production: https://api.finansaku.space/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8081/api/v1/auth/google/callback

# Frontend redirect after successful login
# - Local: http://localhost:5173/oauth-success
# - Production: https://finansaku.space/oauth-success
CLIENT_WEB_REDIRECT=http://localhost:5173/oauth-success

# === Email Service (SMTP via Gmail) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=<your_email_address>
MAIL_PASS=<your_email_app_password>
MAIL_FROM_NAME=FinanSaku
MAIL_FROM_EMAIL=<your_email_address>

# === Logging ===
LOG_LEVEL=debug
LOG_DIR=logs

# === Rate Limiting ===
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_MS=60000

# === Aggregator Service ===
AGGREGATOR_CRON_EXPRESSION=0 3 1 * *
BPS_API_KEY=
AGGREGATOR_SOURCES=https://data.go.id/dataset/ihk-2024.csv|living_cost

# === Application URLs ===
API_BASE_URL=http://localhost:8081
APP_URL=http://localhost:8081
CLIENT_URL=http://localhost:5173

# === Frontend URLs (used in emails) ===
CLIENT_VERIFY_URL=http://localhost:5173/verify-email
CLIENT_RESET_URL=http://localhost:5173/reset-password
CLIENT_EMAIL_CHANGE_URL=http://localhost:5173/email-change

# === OAuth2 URLs ===
OAUTH2_ENDPOINT_GOOGLE=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
