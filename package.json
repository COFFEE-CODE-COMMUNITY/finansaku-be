{
  "name": "finansaku-be",
  "version": "0.1.0-dev",
  "type": "module",
  "description": "FinanSaku backend — Express + Prisma + PostgreSQL API with authentication, rate limiting, and testing setup.",
  "main": "src/server.js",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node --enable-source-maps ./src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "set NODE_ENV=test && set NODE_OPTIONS=--experimental-vm-modules && jest --runInBand --detectOpenHandles",
    "test:emails": "node tests/mailTest.js all"
  },
  "keywords": [
    "finansaku",
    "express",
    "prisma",
    "postgresql",
    "backend",
    "api",
    "auth"
  ],
  "author": "FinanSaku Backend Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "handlebars": "^4.7.8",
    "handlebars-layouts": "^3.1.4",
    "jsonwebtoken": "^9.0.2",
    "juice": "^11.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.10",
    "rate-limit-redis": "^4.2.3",
    "redis": "^5.8.3",
    "resend": "^6.4.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.4.0",
    "@types/node": "^24.7.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.37.0",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma-erd-generator": "^2.1.0",
    "supertest": "^7.1.4"
  }
}
